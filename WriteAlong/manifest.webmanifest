      "purpose": "any maskable"
    },
    {
      "src": "./app/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "./app/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ]
}
